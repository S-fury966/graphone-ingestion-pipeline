# Copy to .env and fill in. NEVER commit .env.
# A tier whose key is missing is skipped by the LLM orchestrator.

# LLM fallback chain (config-driven). Default: Gemini Flash -> Groq Llama.
# A tier whose key is missing is skipped.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: DeepSeek tier is disabled by default; only set this if you enable it.
DEEPSEEK_API_KEY=

# Optional extra LLM tiers (generic OpenAI-compatible, separate daily budgets).
# Disabled in config/llm.yaml until a key is present here.
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# GitHub API (star counts, repo existence checks)
GITHUB_TOKEN=

# Google Sheets export (service account)
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
